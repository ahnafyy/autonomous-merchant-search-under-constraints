  "project": {
    "abstract": "Autonomous shopping poses a finite-horizon decision problem: which merchant should an agent search next, how should it spend limited query resources, and when should it buy? We formulate sequential merchant search under hard time, token, API-call, API-spend, and purchase-price limits. An exact dynamic program for fixed merchant query requirements tracks remaining resources, selects the next feasible merchant, and returns buy, continue, or reject. We release reusable open-source Python and npm packages that implement the planner and expose host-facing permit interfaces without controlling calls, credentials, or purchases. The Python package additionally provides atomic reservation and conservative reconciliation for exact or censored usage. The broader research asks whether extending the algorithm to jointly select merchants and query permits improves a preregistered purchase outcome over fixed feasible baselines on frozen held-out panels while maintaining zero hard-budget violations.",
    "arxiv_categories": [
      "cs.AI"
    ],
    "keywords": [
      "autonomous shopping",
      "online search",
      "optimal stopping",
      "resource constraints",
      "ephemeral offers"
    ],
    "slug": "autonomous-merchant-search-under-constraints",
    "subtitle": "Exact stopping decisions under time, token, API, and purchase-price limits",
    "title": "Autonomous Shopping Optimizer"
  },
  "release": {
    "version": "0.1.0"
  },
