<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weekly full discovery scan.

  The daily panel probe only re-checks products already known to be multi-seller.
  This finds new merchants and newly shared products, so the panel can grow.

  Install:
    cp scripts/com.ahnafyy.ucp-weekly-discovery.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.ahnafyy.ucp-weekly-discovery.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ahnafyy.ucp-weekly-discovery</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ahnafy/appdev/repos/autonomous-merchant-search-under-constraints/scripts/weekly_discovery_scan.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ahnafy/appdev/repos/autonomous-merchant-search-under-constraints</string>

    <!-- Sunday 04:30, well clear of the 03:10 daily panel probe. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/ucp-weekly-discovery.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ucp-weekly-discovery.err</string>

    <key>RunAtLoad</key>
    <false/>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
