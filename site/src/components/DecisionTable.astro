---
interface DecisionRow {
  merchant_count: number;
  dispersion_ratio: number;
  budget_fraction: number;
  relative_improvement: number;
  verdict: "use_adaptive" | "use_fixed" | "no_difference";
}

interface Props {
  rows: DecisionRow[];
}

const { rows } = Astro.props;

const verdictLabel: Record<DecisionRow["verdict"], string> = {
  use_adaptive: "Use adaptive",
  use_fixed: "Use fixed",
  no_difference: "No difference",
};
---

<div
  class="decision-table"
  tabindex="0"
  role="region"
  aria-label="Decision table: when adaptive stopping beats a tuned fixed rule"
>
  <table>
    <caption>
      Whether adaptive stopping beats a tuned fixed rule, by merchant count, cross-merchant price
      spread, and the fraction of merchants the budget allows querying. Values come from a
      simulation calibrated to the measured corpus; a verdict is only reported when the paired
      bootstrap interval excludes zero.
    </caption>
    <thead>
      <tr>
        <th scope="col">Merchants</th>
        <th scope="col">Price spread</th>
        <th scope="col">Budget</th>
        <th scope="col">Improvement</th>
        <th scope="col">Verdict</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr data-verdict={row.verdict}>
          <td>{row.merchant_count}</td>
          <td>{row.dispersion_ratio.toFixed(2)}×</td>
          <td>{Math.round(row.budget_fraction * 100)}%</td>
          <td>{(row.relative_improvement * 100).toFixed(2)}%</td>
          <td>
            <span class={`verdict verdict--${row.verdict}`}>{verdictLabel[row.verdict]}</span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .decision-table {
    overflow-x: auto;
    border: 1px solid var(--line, #d8dde2);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(247, 247, 244, 0.96));
  }

  .decision-table:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  caption {
    caption-side: bottom;
    padding: 0.8rem 0.9rem 0;
    text-align: left;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-muted, #55606b);
  }

  th,
  td {
    padding: 0.7rem 0.9rem;
    text-align: right;
    border-bottom: 1px solid var(--rule, #d8dde2);
  }

  th:first-child,
  td:first-child,
  th:last-child,
  td:last-child {
    text-align: left;
  }

  thead th {
    background: rgba(25, 55, 83, 0.04);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  tbody tr:nth-child(odd) {
    background: rgba(25, 55, 83, 0.015);
  }

  tbody tr[data-verdict="use_adaptive"] {
    background: rgba(82, 108, 89, 0.06);
  }

  tbody tr[data-verdict="use_fixed"] {
    background: rgba(134, 64, 74, 0.05);
  }

  .verdict {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 700;
    border: 1px solid currentColor;
    background: rgba(255, 255, 255, 0.7);
  }

  .verdict--use_adaptive {
    color: #1b6b4a;
  }

  .verdict--use_fixed {
    color: #9a3412;
  }

  .verdict--no_difference {
    color: #55606b;
  }
</style>
