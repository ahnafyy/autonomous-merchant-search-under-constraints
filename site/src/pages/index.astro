---
import ClaimLedger from "../components/ClaimLedger.astro";
import DecisionTable from "../components/DecisionTable.astro";
import HardConstraintDemo from "../components/HardConstraintDemo.astro";
import PlanningWorkbench from "../components/PlanningWorkbench.astro";
import ResultStrip from "../components/ResultStrip.astro";
import RuleComparison from "../components/RuleComparison.astro";
import ResearchLayout from "../layouts/ResearchLayout.astro";
import data from "../generated/site-data.json";

const { project, authors, links, licenses, release, packages, results, claims } = data;
const authorNames = authors.map((author) => author.name).join(", ");
const affiliations = [...new Set(authors.flatMap((author) => author.affiliations))].join(" · ");
const constraintSurface = results.hard_constraint_surface.map((row) => ({
  ...row,
  action: row.action as "buy" | "continue" | "reject_without_feasible_query",
}));
const displayedClaims = claims.filter((claim) => claim.site_visible);
const percent = (value: number) => `${(value * 100).toFixed(1)}%`;
const resultStrip = [
  {
    label: "Merchants measured",
    value: results.merchants_targeted.toLocaleString(),
    note: `${results.catalog_rows.toLocaleString()} live catalog listings`,
    tone: "gold" as const,
  },
  {
    label: "Listings that moved",
    value: percent(results.delisting_rate + results.price_change_rate),
    note: `${percent(results.delisting_rate)} delisted, ${percent(results.price_change_rate)} repriced in one month`,
    tone: "teal" as const,
  },
  {
    label: "Adaptive stopping wins",
    value: `${results.sweep_cells_favoring_adaptive}/${results.sweep_cells}`,
    note: `only above ${results.advantage_min_dispersion_ratio}× price spread`,
    tone: "coral" as const,
  },
];
const decisionTable = results.criteria.decision_table.map((row) => ({
  ...row,
  verdict: row.verdict as "use_adaptive" | "use_fixed" | "no_difference",
}));
const ruleComparison = results.rule_comparison;
const acceptanceFractions = [1, 2, 3, 4, 5, 6].map((k) => {
  let u = 1;
  for (let step = 0; step < k; step += 1) u -= (u * u) / 2;
  return { k, u };
});

---

<ResearchLayout title={project.title} description={project.abstract}>
  <header class="topbar">
    <div class="journal-mark">
      <a class="wordmark" href="#top" aria-label={`${project.title}, back to top`}>{project.slug}</a>
      <span>Open algorithm and software release</span>
    </div>
    <nav aria-label="Primary navigation">
      <a href="#benchmark">Method</a>
      <a href="#rule">Rule</a>
      <a href="#claims">Evidence</a>
      <a href="#reproduce">Materials</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="paper-title">
      <div class="hero__content">
        <div class="article-kicker">
          <span>Computational research</span>
          <span>Version {release.version}</span>
          <span>Open-source Python + npm</span>
        </div>
        <h1 id="paper-title">{project.title}</h1>
        <p class="subtitle">{project.subtitle}</p>
        <p class="hero-result">
          <span>Measured on live merchants</span>
          <strong>
            Adaptive stopping beats a tuned fixed rule, but only once merchants actually differ in price
          </strong>
        </p>
        <div class="author-block">
          <p class="byline">{authorNames}</p>
          <p class="affiliations">{affiliations}</p>
        </div>
        <div class="abstract-block">
          <p class="abstract-label">Abstract</p>
          <p class="abstract">{project.abstract}</p>
        </div>
        <div class="paper-links" aria-label="Paper resources">
          <a href="#workbench">Try the optimizer</a>
          <a href="#reproduce">Python + npm packages</a>
          <a href={links.repository}>Source and evidence</a>
          <a href="#reproduce">Reproduction record</a>
        </div>
      </div>
      <ResultStrip results={resultStrip} />
    </section>

    <section class="section section--rule" id="workbench" aria-labelledby="workbench-title">
      <div class="section__heading">
        <p class="section-number">1</p>
        <div>
          <span class="eyebrow">Interactive optimizer</span>
          <h2 id="workbench-title">Set the limits your agent actually has</h2>
        </div>
      </div>
      <p class="section-intro">
        Change remaining time, average call latency, token use, API allowance, API charge, and the hard purchase cap.
        Planning runs entirely in your browser against the declared synthetic merchant forecasts.
      </p>
      <PlanningWorkbench
        merchantForecasts={results.merchant_forecasts}
        observedPrice={results.observed_price}
        failurePenalty={results.failure_penalty}
      />
    </section>

    <section class="section section--rule" id="benchmark" aria-labelledby="benchmark-title">
      <div class="section__heading">
        <p class="section-number">2</p>
        <div>
          <span class="eyebrow">Method · Minimal benchmark</span>
          <h2 id="benchmark-title">Carry remaining resources into every decision</h2>
        </div>
      </div>
      <div class="prose-grid">
        <div class="prose">
          <p>
            Each Bellman state records the merchant index and the remaining time, tokens, API calls, and API-spend
            capacity. A query is available only when every resource requirement fits. The purchase-price cap is an
            admissibility rule applied before the optimizer can return a buy action.
          </p>
          <div class="equation">
            <p aria-label="Buy at time t when price is no greater than both the price cap and continuation value under the remaining budget">
              buy ⇔ p<sub>t</sub> ≤ min(P<sub>max</sub>, V<sub>t+1</sub>(b − c<sub>t</sub>))
            </p>
            <span aria-hidden="true">(1)</span>
          </div>
          <p>
            With all budgets relaxed, the registered agent rejects the <strong>${results.observed_price}</strong> offer
            and searches again. It buys the same offer when the deadline, token budget, call count, API-spend limit,
            or combined capacity blocks enough future search. Under a <strong>$100 hard purchase cap</strong>, the
            offer is inadmissible and the agent continues despite its availability.
          </p>
        </div>
        <figure class="research-figure">
          <HardConstraintDemo
            surface={constraintSurface}
            observedPrice={results.observed_price}
          />
          <figcaption>
            <strong>Figure 1.</strong> Exact hard-constraint action map. The selector reads generated evidence rows;
            no scientific computation occurs in the browser.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section section--rule" id="rule" aria-labelledby="rule-title">
      <div class="section__heading">
        <p class="section-number">3</p>
        <div>
          <span class="eyebrow">Result · A rule you can compute by hand</span>
          <h2 id="rule-title">Two steps, no solver</h2>
        </div>
      </div>
      <div class="prose-grid">
        <div class="prose">
          <p>
            <strong>Step one.</strong> Your budget is one number, not four. Resources are spent in
            fixed amounts per query, so the horizon is how many further queries you can afford. It
            is a minimum, not a sum — whichever resource runs out first is the one that binds.
          </p>
          <div class="equation">
            <p aria-label="k equals the minimum over resources of the floor of remaining divided by cost per query">
              k = min<sub>r</sub> ⌊ B<sub>r</sub> / c<sub>r</sub> ⌋
            </p>
            <span aria-hidden="true">(2)</span>
          </div>
          <p>
            <strong>Step two.</strong> Accept when the offer in hand falls within a
            horizon-dependent fraction of the price range you expect.
          </p>
          <div class="equation">
            <p aria-label="Buy when the price is at most the price floor plus u sub k times the price range">
              buy ⇔ p ≤ p<sub>min</sub> + u<sub>k</sub>(p<sub>max</sub> − p<sub>min</sub>)
            </p>
            <span aria-hidden="true">(3)</span>
          </div>
          <p>
            The fractions come from u<sub>0</sub> = 1 and u<sub>k+1</sub> = u<sub>k</sub> −
            u<sub>k</sub><sup>2</sup>/2:
            {acceptanceFractions.map(({ k, u }, index) => (
              <span>{index > 0 ? ", " : ""}u<sub>{k}</sub> = {u.toFixed(3)}</span>
            ))}. With one fallback left you accept the midpoint of the range; with six, only the
            cheapest fifth. The threshold <em>rises</em> as the budget drains, because failing to
            buy costs more than overpaying.
          </p>
          <p class="note">
            This recursion is not new. It is the Cayley–Moser problem, posed in 1875 and solved in
            1956; we reproduce it in a price-minimisation form and measure what it is worth here.
          </p>
        </div>
        <figure class="research-figure">
          <RuleComparison
            arms={ruleComparison.arms}
            savingsCaptured={ruleComparison.savings_captured}
            merchantCount={ruleComparison.merchant_count}
          />
          <figcaption>
            <strong>Figure 2.</strong> The closed form captures
            {(results.closed_form_savings_captured * 100).toFixed(1)}% of the achievable saving
            against the exact solver&rsquo;s {(results.solver_savings_captured * 100).toFixed(1)}%.
            The famous 37% rule captures {(results.secretary_savings_captured * 100).toFixed(1)}%
            while spending more queries than any other online rule: it hunts for the single
            cheapest merchant, when the objective only rewarded the expected price paid.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section section--claims" id="claims" aria-labelledby="claims-title">
      <div class="section__heading">
        <p class="section-number">4</p>
        <div>
          <span class="eyebrow">Result · When it is worth it</span>
          <h2 id="claims-title">Where adaptive stopping pays for itself</h2>
        </div>
      </div>
      <p class="section-intro">
        On {results.held_out_episode_count} held-out episodes built from live merchants, the adaptive rule
        lowered failure-penalized purchase loss against the strongest tuned fixed rule, with the whole
        bootstrap interval below zero and {results.hard_budget_violations} budget violations. The margin is
        small because the median episode has only {results.median_merchant_count} merchants at a price ratio
        of {results.median_price_dispersion_ratio}. The table below maps where the rule earns its complexity
        and where a constant is the better engineering choice.
      </p>
      <figure class="research-figure">
        <DecisionTable rows={decisionTable} />
        <figcaption>
          <strong>Table 1.</strong> Decision table over {results.sweep_cells} calibrated cells. Adaptive
          stopping never wins at or below a {results.no_advantage_dispersion_at_or_below}× price spread, and
          loses outright in {results.sweep_cells_favoring_fixed} cells where the budget is too tight to act
          on what a query reveals.
        </figcaption>
      </figure>
      <ClaimLedger claims={displayedClaims} />
    </section>

    <section class="section section--materials" id="reproduce" aria-labelledby="reproduce-title">
      <div class="section__heading">
        <p class="section-number">5</p>
        <div>
          <span class="eyebrow">Open-source implementations and evidence</span>
          <h2 id="reproduce-title">Run the optimizer or reproduce the research</h2>
        </div>
      </div>
      <p class="section-intro">
        The Python and npm packages provide reusable implementations of the current exact planner. Python additionally
        supports atomic reservation receipts and censored-usage reconciliation; npm currently covers planner and
        completed-call behavior. One deterministic build produces shared conformance vectors, the evidence ledger,
        manuscript inputs, and this explainer from the canonical Python package.
      </p>
      <dl class="artifact-list">
        <div><dt>Evidence</dt><dd><a href={`${links.repository}/tree/main/artifacts`}>Generated artifacts</a></dd></div>
        <div><dt>Python</dt><dd><a href={`${links.repository}/tree/main/packages/python`}>{packages.python.distribution}</a></dd></div>
        <div><dt>npm</dt><dd><a href={`${links.repository}/tree/main/packages/javascript`}>{packages.javascript.name}</a></dd></div>
        <div><dt>Licenses</dt><dd>{licenses.code} · {licenses.content}</dd></div>
        <div><dt>Seed</dt><dd>{results.random_seed}</dd></div>
      </dl>
    </section>
  </main>

  <footer>
    <div>
      <p class="footer-title">{project.title}</p>
      <p>{authorNames} · Version {release.version}</p>
    </div>
    <p><a href={links.repository}>Repository</a> · <a href="#claims">Claim ledger</a></p>
  </footer>
</ResearchLayout>
